					if (oldScript.innerHTML) {
						newScript.innerHTML = oldScript.innerHTML;
					}
					document.body.appendChild(newScript);
				});
				Array.from(container.children).forEach(el => {
					if (el.tagName !== 'SCRIPT') {
						document.body.appendChild(el.cloneNode(true));
					}
				});
