-2.586 7-2.777 7 2.476v6.759z" data-astro-cid-tkqcxkj7></path></svg></button><button data-share-hackernews class="p-2 bg-white dark:bg-gray-900 text-gray-500 dark:text-gray-300 hover:text-[#ff6600] dark:hover:text-[#ff8a3b] hover:bg-orange-50 dark:hover:bg-orange-500/10 border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md hover:border-orange-100 dark:hover:border-orange-500/30 transition-all duration-200 rounded-[var(--radius-button,12px)]" aria-label="Share on Hacker News" data-astro-cid-tkqcxkj7><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" data-astro-cid-tkqcxkj7><path d="M0 0v24h24V0H0zm12.3 13.34v5.52h-1.26v-5.52L7.56 6.14h1.4l2.94 5.18 2.94-5.18h1.4l-3.54 7.2z" data-astro-cid-tkqcxkj7></path></svg></button><button data-copy-link class="p-2 bg-white dark:bg-gray-900 text-gray-500 dark:text-gray-300 hover:text-purple-600 dark:hover:text-purple-300 hover:bg-purple-50 dark:hover:bg-purple-500/10 border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md hover:border-purple-100 dark:hover:border-purple-500/30 transition-all duration-200 rounded-[var(--radius-button,12px)]" aria-label="Copy Link" data-astro-cid-tkqcxkj7><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" data-astro-cid-tkqcxkj7><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" data-astro-cid-tkqcxkj7></path></svg></button></div><!-- Progress Track --><div class="absolute left-0 top-0 bottom-0 w-px bg-purple-100 dark:bg-purple-500/20 rounded-full" data-astro-cid-tkqcxkj7></div><!-- Reading Progress Bar --><div id="toc-progress-desktop" class="absolute left-0 top-0 w-px bg-purple-600 dark:bg-purple-400 transition-all duration-75 origin-top rounded-full z-10 h-0 shadow-[0_0_10px_rgba(147,51,234,0.5)]" data-astro-cid-tkqcxkj7></div><div class="py-2 max-h-[calc(100vh-200px)] overflow-y-auto toc-custom-scrollbar pr-2 relative" data-astro-cid-tkqcxkj7><h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-2 pl-3 group" data-astro-cid-tkqcxkj7><span class="group-hover:text-purple-600 dark:group-hover:text-purple-300 transition-colors" data-astro-cid-tkqcxkj7>Table of Contents</span></h3><ul class="text-sm space-y-1 toc-outline" data-astro-cid-tkqcxkj7><li data-astro-cid-tkqcxkj7><a href="#quick-comparison" data-toc-link data-astro-cid-tkqcxkj7>Quick Comparison</a></li><li data-astro-cid-tkqcxkj7><a href="#1-llama" data-toc-link data-astro-cid-tkqcxkj7>1. Llama)</a></li><li data-astro-cid-tkqcxkj7><a href="#2-mistral" data-toc-link data-astro-cid-tkqcxkj7>2. Mistral</a></li><li data-astro-cid-tkqcxkj7><a href="#3-qwen" data-toc-link data-astro-cid-tkqcxkj7>3. Qwen</a></li><li data-astro-cid-tkqcxkj7><a href="#4-deepseek" data-toc-link data-astro-cid-tkqcxkj7>4. DeepSeek</a></li><li data-astro-cid-tkqcxkj7><a href="#5-gemma" data-toc-link data-astro-cid-tkqcxkj7>5. Gemma</a></li><li data-astro-cid-tkqcxkj7><a href="#6-phi" data-toc-link data-astro-cid-tkqcxkj7>6. Phi)</a></li><li data-astro-cid-tkqcxkj7><a href="#which-model-to-pick-for-your-hardware-setup" data-toc-link data-astro-cid-tkqcxkj7>Which Model to Pick for Your Hardware Setup</a></li><li data-astro-cid-tkqcxkj7><a href="#pros-and-cons-of-each-local-llm-family" data-toc-link data-astro-cid-tkqcxkj7>Pros and Cons of Each Local LLM Family</a></li><li data-astro-cid-tkqcxkj7><a href="#conclusion" data-toc-link data-astro-cid-tkqcxkj7>Conclusion</a></li><li data-astro-cid-tkqcxkj7><a href="#faqs" data-toc-link data-astro-cid-tkqcxkj7>FAQs</a></li></ul></div><!-- Slot for additional sidebar content (e.g., newsletter signup) --><div class="mt-4 pl-4" data-astro-cid-tkqcxkj7><a href="https://api.daily.dev/get" class="CTA block w-full px-4 py-2.5 rounded-lg bg-gray-900 text-white text-sm font-bold hover:bg-purple-600 transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 text-center no-underline flex items-center justify-center gap-2 group" ta="blog-sidebar-extension" rel="noopener noreferrer"> Get daily.dev <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path> </svg> </a></div></div></div></aside><div id="copy-toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-4 py-2.5 rounded-full text-sm font-semibold shadow-xl opacity-0 pointer-events-none transition-opacity duration-300 z-50 flex items-center gap-2" data-astro-cid-tkqcxkj7><svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" data-astro-cid-tkqcxkj7><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" data-astro-cid-tkqcxkj7></path></svg>
