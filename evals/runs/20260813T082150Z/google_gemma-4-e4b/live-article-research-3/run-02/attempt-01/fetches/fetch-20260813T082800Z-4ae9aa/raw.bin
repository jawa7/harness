  (() => {
    if (window.__dailyDevBlogPostPrefetchReady) return;
    window.__dailyDevBlogPostPrefetchReady = true;

    const MAX_PREFETCHES = 8;
    const prefetched = new Set();

    const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    const canPrefetch = !connection?.saveData && !/(^|-)2g$/i.test(connection?.effectiveType || '');

    function toPrefetchHref(rawHref) {
      if (!canPrefetch || prefetched.size >= MAX_PREFETCHES) return null;

      const url = new URL(rawHref, window.location.href);
      if (url.origin !== window.location.origin) return null;
      if (!url.pathname.startsWith('/blog/') || url.pathname === '/blog/') return null;
      if (url.pathname === window.location.pathname) return null;

      return `${url.pathname}${url.search}`;
    }

    function prefetch(rawHref) {
      const href = toPrefetchHref(rawHref);
      if (!href || prefetched.has(href)) return;

      prefetched.add(href);
      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.as = 'document';
      link.href = href;
      link.setAttribute('fetchpriority', 'low');
      document.head.appendChild(link);
    }

    function observeBlogLinks(root = document) {
      if (!canPrefetch) return;

      root.querySelectorAll('a[href^="/blog/"], a[href^="https://daily.dev/blog/"]').forEach((link) => {
        if (link.dataset.blogPostPrefetchObserved === 'true') return;
        if (!toPrefetchHref(link.href)) return;

        link.dataset.blogPostPrefetchObserved = 'true';
        link.addEventListener('pointerenter', () => prefetch(link.href), { once: true });
        link.addEventListener('focus', () => prefetch(link.href), { once: true });
      });
    }

    window.dailyDevObserveBlogPostPrefetchLinks = observeBlogLinks;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => observeBlogLinks(), { once: true });
    } else {
      observeBlogLinks();
    }
  })();
</script> <script>
  (() => {
    const frames = Array.from(document.querySelectorAll('.blog-content iframe[data-src]'));
    if (frames.length === 0) return;

    const loadFrame = (frame) => {
      const src = frame.getAttribute('data-src');
      if (!src || frame.getAttribute('src') === src) return;
      frame.setAttribute('src', src);
      frame.removeAttribute('data-src');
    };

    const observeFrames = () => {
      if (!('IntersectionObserver' in window)) {
        frames.forEach(loadFrame);
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          loadFrame(entry.target);
        });
      }, { rootMargin: '300px 0px', threshold: 0 });

      frames.forEach((frame) => observer.observe(frame));
    };

    const schedule = () => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(observeFrames, { timeout: 1500 });
        return;
      }
      window.setTimeout(observeFrames, 250);
    };

    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule, { once: true });
  })();
</script> <script>
  (() => {
    const navRoot = document.getElementById('blog-adjacent-nav');
    const relatedSection = document.getElementById('blog-related-posts');
    const relatedGrid = document.getElementById('blog-related-grid');
    const moreUrl = navRoot?.dataset.moreUrl;
    if (!navRoot || !moreUrl) return;

    const escapeHtml = (value) => String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

    const formatDate = (value) => {
      const date = new Date(value);
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    };

    const navCard = (post, label, direction) => post?.slug ? `
      <a href="/blog/${escapeHtml(post.slug)}/" class="group relative flex flex-col gap-1 overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-300 hover:border-gray-300 hover:bg-gray-50 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-gray-700 dark:hover:bg-gray-900 ${direction === 'next' ? 'items-end text-right' : ''}">
        <span class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-500 transition-colors group-hover:text-purple-600 dark:text-gray-400 dark:group-hover:text-purple-300">
          ${direction === 'prev' ? '<svg class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>' : ''}
          ${label}
          ${direction === 'next' ? '<svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>' : ''}
        </span>
        <h3 class="mb-1 line-clamp-2 text-lg font-bold leading-snug text-gray-900 dark:text-gray-100">${escapeHtml(post.name)}</h3>
        <span class="text-sm font-medium text-gray-600 dark:text-gray-300">${escapeHtml(formatDate(post.date))}</span>
      </a>
    ` : '<div></div>';

    const relatedCard = (post) => {
      if (!post?.slug) return '';
      const cover = post.coverImage;
      const srcsetAttr = cover?.srcset
        ? ` srcset="${escapeHtml(cover.srcset)}" sizes="${escapeHtml(cover.sizes || '')}"`
        : '';
      return `
      <a href="/blog/${escapeHtml(post.slug)}/" class="group flex flex-col rounded-2xl border border-gray-100 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-purple-200 hover:shadow-lg dark:border-gray-800 dark:bg-gray-950 dark:hover:border-purple-500/30">
        ${cover?.url ? `
          <div class="mb-4 aspect-[16/9] overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
            <img src="${escapeHtml(cover.url)}"${srcsetAttr} alt="${escapeHtml(cover.alt || post.name)}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" width="${Number(cover.width) || 640}" height="${Number(cover.height) || 360}" loading="lazy" decoding="async" />
          </div>
        ` : ''}
        <div class="mb-2 flex items-center gap-2 text-[11px] font-medium text-gray-500 dark:text-gray-400">
          ${post.category ? `<span class="rounded-md bg-purple-50 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-purple-700 dark:bg-purple-500/10 dark:text-purple-300">${escapeHtml(post.category.name)}</span>` : ''}
          <time datetime="${escapeHtml(post.date)}" class="tabular-nums">${escapeHtml(formatDate(post.date))}</time>
        </div>
        <h3 class="text-base font-semibold leading-snug text-gray-900 transition-colors group-hover:text-purple-700 dark:text-gray-100 dark:group-hover:text-purple-300">${escapeHtml(post.name)}</h3>
        ${post.metaDescription ? `<p class="mt-2 line-clamp-2 text-sm text-gray-500 dark:text-gray-400">${escapeHtml(post.metaDescription)}</p>` : ''}
      </a>
    `;
    };

    let hasLoadedMoreModules = false;

    const loadMoreModules = () => {
      if (hasLoadedMoreModules) return;
      hasLoadedMoreModules = true;

      fetch(moreUrl, { credentials: 'same-origin' })
        .then((response) => {
          if (!response.ok) throw new Error(`more ${response.status}`);
          return response.json();
        })
        .then((data) => {
          navRoot.innerHTML = `
            <div class="mt-12 flex flex-col gap-6">
              ${navCard(data.prev, 'Previous post', 'prev')}
              ${navCard(data.next, 'Next post', 'next')}
            </div>
          `;

          if (relatedSection && relatedGrid && relatedGrid.children.length === 0 && Array.isArray(data.related) && data.related.length > 0) {
            relatedGrid.innerHTML = data.related.map(relatedCard).join('');
            relatedSection.classList.remove('hidden');
            window.dailyDevObserveBlogPostPrefetchLinks?.(relatedGrid);
          }
        })
        .catch(() => {
          hasLoadedMoreModules = false;
          navRoot.remove();
          relatedSection?.remove();
        });
    };

    const observeAdjacentNav = () => {
      if (!('IntersectionObserver' in window)) {
        window.setTimeout(loadMoreModules, 1200);
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          loadMoreModules();
        });
      }, { rootMargin: '700px 0px', threshold: 0 });

      observer.observe(navRoot);
    };

    const scheduleObservation = () => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(observeAdjacentNav, { timeout: 2500 });
        return;
      }
      window.setTimeout(observeAdjacentNav, 400);
    };

    if (document.readyState === 'complete') scheduleObservation();
    else window.addEventListener('load', scheduleObservation, { once: true });
  })();
</script> <script>(function(){const postTitle = "The Best Local LLM Models to Run in 2026";
const postDescription = "Compare six top local LLM families and choose by memory first, then task—recommendations for 8GB to 48GB+ setups and core use cases.";
const postUrl = "https://daily.dev/blog/best-local-llm-models-run/";

  // Mobile-only bottom-of-article CTAs (`nativeShare` + `copyLink`).
  //
  // The desktop X / LinkedIn / Hacker News share buttons live in the
  // sticky TOC sidebar (`packages/ui/components/TableOfContents.astro`),
  // which wires its own `data-share-*` listeners scoped to the
  // component's `define:vars` block. We don't need page-level
  // `shareTwitter / shareLinkedIn / shareHackerNews` helpers any more —
  // the only inline `onclick` handlers left on this page are the two
  // mobile CTAs below.
  window.nativeShare = async function() {
    const data = { title: postTitle, text: postDescription || postTitle, url: postUrl };
    try {
      if (navigator.share) await navigator.share(data);
      else window.copyLink();
    } catch { /* user cancelled */ }
  };
  window.copyLink = function() {
    const showToast = () => typeof window.showCopyToast === 'function' && window.showCopyToast('Link copied!');
    navigator.clipboard.writeText(postUrl).then(showToast).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = postUrl;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showToast();
    });
  };
})();</script>