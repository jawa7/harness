 </div> <span class="logo-menu-label text-[13px] font-medium transition-colors duration-200" data-astro-cid-luczcnc7>Brand Assets</span> </a> </div> </div> </div> <div id="main-header-logo-context-menu-copy-toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-slate-900 text-white dark:bg-white dark:text-gray-900 px-4 py-2.5 rounded-full text-sm font-semibold shadow-xl dark:shadow-[0_18px_40px_-12px_rgba(0,0,0,0.55)] opacity-0 pointer-events-none transition-opacity duration-300 z-toast flex items-center gap-2"> <svg class="w-4 h-4 text-green-400 dark:text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span>SVG copied to clipboard</span> </div> <script>
  if (!window.__dailyCopyToast) {
    window.__dailyCopyToast = true;
    window.showCopyToast = function(message = 'Link copied!', toastId = 'copy-toast') {
      const toast = document.getElementById(toastId);
      if (!toast) return;
      const text = toast.querySelector('span');
      if (text) text.textContent = message;
      toast.style.opacity = '1';
      toast.style.pointerEvents = 'auto';
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.pointerEvents = 'none';
      }, 2500);
    };
  }
</script> <div class="sr-only" aria-live="polite" data-logo-context-live data-astro-cid-luczcnc7></div> </div>  <script>(function(){const menuId = "main-header-logo-context-menu";
const toastId = "main-header-logo-context-menu-copy-toast";

  const w = window;
  const cleanupRegistry =
    w.__logoContextMenuCleanupRegistry ||
    (w.__logoContextMenuCleanupRegistry = new Map());

  const initLogoContextMenu = () => {
    const prevCleanup = cleanupRegistry.get(menuId);
    if (typeof prevCleanup === 'function') prevCleanup();

    const root = document.querySelector(`[data-logo-context-root="${menuId}"]`);
    if (!root) return;

    const menu = root.querySelector(`#${menuId}`);
    const menuPanel = root.querySelector('[data-logo-menu-panel]');
    const trigger = root.querySelector('[data-logo-context-trigger]');
    const copyBtn = root.querySelector('[data-copy-svg-btn]');
    const lightModeBtn = root.querySelector('[data-logo-mode-light]');
    const darkModeBtn = root.querySelector('[data-logo-mode-dark]');
    const live = root.querySelector('[data-logo-context-live]');
    if (!menu || !menuPanel || !trigger || !copyBtn || !lightModeBtn || !darkModeBtn || !live) return;

    const fadeDuration = 150;
    // Build allowlist from component markup so paths stay in sync.
    const allowlist = new Set(
      [
        copyBtn.getAttribute('data-light-src') || '',
        copyBtn.getAttribute('data-dark-src') || '',
      ].filter((path) => path.startsWith('/assets/brand/') && path.endsWith('.svg'))
    );

    let isMenuOpen = false;
    let focusedIndex = -1;
    let currentMode = 'light';

    const menuItems = menu.querySelectorAll('.logo-menu-item');
    const downloadItems = menu.querySelectorAll('.logo-download-item');

    const announce = (message) => {
      live.textContent = '';
      setTimeout(() => {
        live.textContent = message;
      }, 30);
    };

    const setLogoMode = (mode) => {
      currentMode = mode;
      menuPanel.classList.toggle('logo-menu-dark', mode === 'dark');

      if (mode === 'light') {
        lightModeBtn.setAttribute('aria-checked', 'true');
        darkModeBtn.setAttribute('aria-checked', 'false');
        lightModeBtn.style.cssText = 'background:#fff;color:#111827;box-shadow:0 1px 2px rgba(0,0,0,.1)';
        darkModeBtn.style.cssText = 'background:transparent;color:#9ca3af;box-shadow:none';
      } else {
        darkModeBtn.setAttribute('aria-checked', 'true');
        lightModeBtn.setAttribute('aria-checked', 'false');
        darkModeBtn.style.cssText = 'background:#4b5563;color:#fff;box-shadow:0 1px 2px rgba(0,0,0,.2)';
        lightModeBtn.style.cssText = 'background:transparent;color:#6b7280;box-shadow:none';
      }

      downloadItems.forEach((item) => {
        const href = item.getAttribute(`data-${mode}-href`);
        const download = item.getAttribute(`data-${mode}-download`);
        if (href) item.setAttribute('href', href);
        if (download) item.setAttribute('download', download);
      });
    };

    const showMenu = (x, y) => {
      menu.style.left = '-9999px';
      menu.style.top = '-9999px';
      menu.classList.remove('hidden');

      const rect = menuPanel.getBoundingClientRect();
      const menuWidth = rect.width || 220;
      const menuHeight = rect.height || 300;

      menu.classList.add('hidden');

      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;
      let finalX = x;
      let finalY = y;

      if (x + menuWidth > viewportWidth - 10) {
        finalX = viewportWidth - menuWidth - 10;
      }
      if (y + menuHeight > viewportHeight - 10) {
        finalY = Math.max(10, viewportHeight - menuHeight - 10);
      }

      menu.style.left = `${finalX}px`;
      menu.style.top = `${finalY}px`;
      menu.classList.remove('hidden');
      isMenuOpen = true;
      focusedIndex = 0;
      setLogoMode('light');
      requestAnimationFrame(() => {
        if (!isMenuOpen) return;
        menu.classList.remove('opacity-0');
        menu.classList.add('opacity-100');
      });
      menuItems[0]?.focus();
    };

    const hideMenu = () => {
      if (!isMenuOpen) return;
      menu.classList.remove('opacity-100');
      menu.classList.add('opacity-0');
      setTimeout(() => {
        menu.classList.add('hidden');
      }, fadeDuration);
      isMenuOpen = false;
      focusedIndex = -1;
    };

    const showToast = (message = 'SVG copied to clipboard') => {
      if (typeof window.showCopyToast === 'function') {
        window.showCopyToast(message, toastId);
      }
    };

    const onContextMenu = (event) => {
      if (window.matchMedia('(pointer: coarse)').matches) return;
      event.preventDefault();
      showMenu(event.clientX, event.clientY);
    };

    const onTriggerKeyDown = (event) => {
      // Support keyboard shortcuts for opening context menu:
      // 1. Shift+F10 (Windows standard)
      // 2. ContextMenu key (if supported by browser/keyboard)
      // Keep Enter/Space for normal link/button activation.
      const isContextMenuKey = event.key === 'ContextMenu' || (event.shiftKey && event.key === 'F10');

      if (isContextMenuKey) {
        event.preventDefault();
        const rect = trigger.getBoundingClientRect();
        showMenu(rect.left, rect.bottom + 6);
      }
      if (event.key === 'Escape') {
        hideMenu();
      }
    };

    const onLightClick = (event) => {
      event.stopPropagation();
      setLogoMode('light');
    };
    const onDarkClick = (event) => {
      event.stopPropagation();
      setLogoMode('dark');
    };

    const onCopyClick = async (event) => {
      event.preventDefault();
      const src = copyBtn.getAttribute(`data-${currentMode}-src`) || '/assets/brand/daily-dev-logo.svg';
      if (!allowlist.has(src)) {
        showToast('Failed to copy SVG');
        hideMenu();
        return;
      }
      try {
        const response = await fetch(src);
        if (!response.ok) throw new Error('Failed to fetch svg');
        const svgText = await response.text();
        await navigator.clipboard.writeText(svgText);
        showToast('SVG copied to clipboard');
        announce('SVG copied to clipboard');
      } catch {
        showToast('Failed to copy SVG');
        announce('Failed to copy SVG');
      }
      hideMenu();
    };

    const onDocumentClick = (event) => {
      if (!isMenuOpen) return;
      if (!root.contains(event.target)) {
        hideMenu();
      }
    };

    const onScroll = () => {
      hideMenu();
    };

    const onKeyDown = (event) => {
      if (!isMenuOpen) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        hideMenu();
        trigger.focus();
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        focusedIndex = (focusedIndex + 1) % menuItems.length;
        menuItems[focusedIndex]?.focus();
      }
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        focusedIndex = focusedIndex <= 0 ? menuItems.length - 1 : focusedIndex - 1;
        menuItems[focusedIndex]?.focus();
      }
    };

    trigger.addEventListener('contextmenu', onContextMenu);
    trigger.addEventListener('keydown', onTriggerKeyDown);
    lightModeBtn.addEventListener('click', onLightClick);
    darkModeBtn.addEventListener('click', onDarkClick);
    copyBtn.addEventListener('click', onCopyClick);
    document.addEventListener('click', onDocumentClick);
    document.addEventListener('keydown', onKeyDown);
    document.addEventListener('scroll', onScroll, { passive: true });

    cleanupRegistry.set(menuId, () => {
      trigger.removeEventListener('contextmenu', onContextMenu);
      trigger.removeEventListener('keydown', onTriggerKeyDown);
      lightModeBtn.removeEventListener('click', onLightClick);
      darkModeBtn.removeEventListener('click', onDarkClick);
      copyBtn.removeEventListener('click', onCopyClick);
      document.removeEventListener('click', onDocumentClick);
      document.removeEventListener('keydown', onKeyDown);
      document.removeEventListener('scroll', onScroll);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLogoContextMenu);
  } else {
    initLogoContextMenu();
  }
  document.addEventListener('astro:page-load', initLogoContextMenu);
})();</script> <div class="hidden lg:flex items-center gap-0.5" data-astro-cid-3ef6ksr2>  <a href="/" data-ta="header-nav-product" class="CTA rounded-lg px-3 py-2 text-sm font-semibold text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors" data-astro-cid-3ef6ksr2> Product </a> <div class="nav-group relative" data-astro-cid-3ef6ksr2> <button type="button" class="nav-trigger rounded-lg px-3 py-2 text-sm font-semibold text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors" aria-expanded="false" aria-haspopup="true" data-astro-cid-3ef6ksr2> For business </button> <div class="nav-panel absolute left-0 top-full pt-2.5" data-astro-cid-3ef6ksr2> <div class="rounded-2xl border border-gray-200/80 bg-white p-3 shadow-2xl shadow-black/[0.08] dark:border-white/10 dark:bg-[#0f0f12] dark:shadow-black/50" data-astro-cid-3ef6ksr2> <div class="flex gap-2" data-astro-cid-3ef6ksr2>  <div class="flex w-[210px] flex-col justify-center" data-astro-cid-3ef6ksr2> <a href="https://business.daily.dev/?ref=daily-header" data-ta="sister-advertisers" target="_blank" rel="noopener noreferrer" class="CTA flex flex-col gap-0.5 rounded-xl px-2.5 py-2 hover:bg-gray-100 dark:hover:bg-white/5 transition-colors" data-astro-cid-3ef6ksr2> <span class="text-[14px] font-semibold text-gray-800 dark:text-gray-100" data-astro-cid-3ef6ksr2>For Advertisers</span> <span class="text-[12px] leading-snug text-gray-500 dark:text-gray-400" data-astro-cid-3ef6ksr2>In-feed ads, sponsored content &amp; more</span> </a><a href="https://recruiter.daily.dev/?ref=daily-header" data-ta="sister-recruiters" target="_blank" rel="noopener noreferrer" class="CTA flex flex-col gap-0.5 rounded-xl px-2.5 py-2 hover:bg-gray-100 dark:hover:bg-white/5 transition-colors" data-astro-cid-3ef6ksr2> <span class="text-[14px] font-semibold text-gray-800 dark:text-gray-100" data-astro-cid-3ef6ksr2>For Recruiters</span> <span class="text-[12px] leading-snug text-gray-50