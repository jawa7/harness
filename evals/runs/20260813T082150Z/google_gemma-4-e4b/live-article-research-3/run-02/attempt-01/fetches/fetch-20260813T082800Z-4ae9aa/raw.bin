</div><script>(function(){const contentSelector = ".blog-content";
const scrollOffset = 100;
const shareUrl = "https://daily.dev/blog/best-local-llm-models-run/";
const shareTitle = "The Best Local LLM Models to Run in 2026";
const shareDescription = "Compare six top local LLM families and choose by memory first, then task—recommendations for 8GB to 48GB+ setups and core use cases.";

  // Prevent multiple initializations when component is used multiple times
  if (!window.__tocInitialized) {
    window.__tocInitialized = true;

    // --- Share Logic ---
    const setupShareButtons = () => {
      if (!shareUrl) return;

      const twitterBtns = document.querySelectorAll('[data-share-twitter]');
      const linkedinBtns = document.querySelectorAll('[data-share-linkedin]');
      const hackernewsBtns = document.querySelectorAll('[data-share-hackernews]');
      const copyBtns = document.querySelectorAll('[data-copy-link]');
      const nativeShareBtns = document.querySelectorAll('[data-share-native]');

      const shareTwitter = () => {
        const text = shareDescription
          ? `${shareTitle} - ${shareDescription}`
          : `Check out this article: ${shareTitle}`;
        window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(shareUrl)}`, '_blank', 'width=550,height=420');
      };

      const shareLinkedIn = () => {
        window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`, '_blank');
      };

      const shareHackerNews = () => {
        window.open(`https://news.ycombinator.com/submitlink?u=${encodeURIComponent(shareUrl)}&t=${encodeURIComponent(shareTitle)}`, '_blank', 'width=550,height=420');
      };

      const copyLink = () => {
        navigator.clipboard.writeText(shareUrl).then(() => {
          const toast = document.getElementById('copy-toast');
          if (toast) {
            toast.style.opacity = '1';
            setTimeout(() => { toast.style.opacity = '0'; }, 2500);
          }
        }).catch(() => {
          // Fallback
          const textArea = document.createElement('textarea');
          textArea.value = shareUrl;
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          document.body.removeChild(textArea);

          const toast = document.getElementById('copy-toast');
          if (toast) {
            toast.style.opacity = '1';
            setTimeout(() => { toast.style.opacity = '0'; }, 2500);
          }
        });
      };

      const nativeShare = async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: shareTitle,
              text: shareDescription,
              url: shareUrl
            });
          } catch (err) {
            // User cancelled or error
          }
        } else {
          // Fallback to copy link
          copyLink();
        }
      };

      twitterBtns.forEach(btn => btn.addEventListener('click', shareTwitter));
      linkedinBtns.forEach(btn => btn.addEventListener('click', shareLinkedIn));
      hackernewsBtns.forEach(btn => btn.addEventListener('click', shareHackerNews));
      copyBtns.forEach(btn => btn.addEventListener('click', copyLink));
      nativeShareBtns.forEach(btn => btn.addEventListener('click', nativeShare));
    };

    document.addEventListener('DOMContentLoaded', () => {
      setupShareButtons();

      const tocLinks = document.querySelectorAll('[data-toc-link]');
      const contentElements = Array.from(document.querySelectorAll(contentSelector));
      const progressBarDesktop = document.getElementById('toc-progress-desktop');
      const progressBarMobile = document.getElementById('toc-progress-mobile');
      let contentBounds = {
        top: 0,
        bottom: document.documentElement.scrollHeight,
        height: Math.max(0, document.documentElement.scrollHeight - window.innerHeight),
      };

      const measureContentBounds = () => {
        if (contentElements.length > 0) {
          let contentTop = Infinity;
          let contentBottom = 0;
          const currentScrollY = window.scrollY;

          contentElements.forEach((element) => {
            const box = element.getBoundingClientRect();
            const elementTop = box.top + currentScrollY;
            const elementBottom = elementTop + box.height;
            if (elementTop < contentTop) contentTop = elementTop;
            if (elementBottom > contentBottom) contentBottom = elementBottom;
          });

          return {
            top: contentTop,
            bottom: contentBottom,
            height: Math.max(0, contentBottom - contentTop),
          };
        }

        return {
          top: 0,
          bottom: document.documentElement.scrollHeight,
          height: Math.max(0, document.documentElement.scrollHeight - window.innerHeight),
        };
      };


      if (!tocLinks.length) return;

      // --- 1. Click Handler (Smooth Scroll) ---
      tocLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const href = link.getAttribute('href');
          if (!href) return;

          const targetId = href.substring(1);
          const targetElement = document.getElementById(targetId);

          if (targetElement) {
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - scrollOffset;

            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        });
      });

      // --- 2. Active Section Logic ---
      // Filter for top-level links only
      const topLevelLinks = Array.from(tocLinks).filter((link) => {
        const listItem = link.closest('li');
        if (!listItem || !listItem.parentElement) return false;
        return !listItem.parentElement.closest('li');
      });

      // Build unique sections list (handling potential duplicates from Mobile/Desktop TOCs)
      const sections = [];
      const seenIds = new Set();

      topLevelLinks.forEach((link) => {
        const href = link.getAttribute('href');
        if (!href) return;
        const id = href.substring(1);

        // Avoid duplicate sections if both Mobile and Desktop TOCs are present
        if (seenIds.has(id)) return;

        const headingElement = document.getElementById(id);
        if (!headingElement) return;

        seenIds.add(id);
        sections.push({ id, headingElement, top: 0 });
      });

      const recalculateLayoutMetrics = () => {
        contentBounds = measureContentBounds();
        const currentScrollY = window.scrollY;

        sections.forEach((section) => {
          section.top = section.headingElement.getBoundingClientRect().top + currentScrollY;
        });
      };

      const updateActiveSection = () => {
        if (!sections.length) return;

        let activeId = sections[0].id; // Default to first section
        const currentScrollY = window.scrollY;
        const scrollTop = currentScrollY + scrollOffset + 10; // +10 for small buffer

        // Find the last section whose top is above the current scroll position
        // This activates a section as soon as its top reaches the viewport top
        for (let i = sections.length - 1; i >= 0; i--) {
          if (scrollTop >= sections[i].top) {
            activeId = sections[i].id;
            break;
          }
        }

        // Special case: if we're at the bottom of the page, highlight the last item
        const viewportBottom = currentScrollY + window.innerHeight;

        if (viewportBottom >= contentBounds.bottom - 4 && sections.length) {
          activeId = sections[sections.length - 1].id;
        }

        // Update ALL links (both mobile and desktop) matching the active ID
        tocLinks.forEach(link => {
          const href = link.getAttribute('href');
          if (href === `#${activeId}`) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      };

      // --- 3. Progress Bar Logic ---
      const updateProgressBar = () => {
        const scrollY = window.scrollY;
        const windowHeight = window.innerHeight;

        const { top: contentTop, height: contentHeight } = contentBounds;

        // Calculate progress relative to the content area
        const start = contentTop - windowHeight + 150;
        const end = contentTop + contentHeight - windowHeight + 100;

        let progress = 0;
        if (scrollY > start) {
          progress = Math.min(100, Math.max(0, ((scrollY - start) / (end - start)) * 100));
        }
        if (scrollY > end) progress = 100;

        if (progressBarDesktop) {
          progressBarDesktop.style.height = `${progress}%`;
        }

        if (progressBarMobile) {
          progressBarMobile.style.width = `${progress}%`;
        }
      };

      let ticking = false;
      const handleScroll = () => {
        if (ticking) return;
        window.requestAnimationFrame(() => {
          updateActiveSection();
          updateProgressBar();
          ticking = false;
        });
        ticking = true;
      };

      let metricsTicking = false;
      const refreshLayoutMetrics = () => {
        if (metricsTicking) return;
        metricsTicking = true;
        window.requestAnimationFrame(() => {
          recalculateLayoutMetrics();
          updateActiveSection();
          updateProgressBar();
          metricsTicking = false;
        });
      };

      const resizeObserver = 'ResizeObserver' in window
        ? new ResizeObserver(refreshLayoutMetrics)
        : null;
      if (resizeObserver) {
        contentElements.forEach((element) => resizeObserver.observe(element));
      }

      recalculateLayoutMetrics();
      updateActiveSection();
      updateProgressBar();
      window.addEventListener('scroll', handleScroll, { passive: true });
      window.addEventListener('resize', refreshLayoutMetrics);
      window.addEventListener('load', refreshLayoutMetrics, { once: true });
      setTimeout(refreshLayoutMetrics, 500);
    });
  }
})();</script> </div> </div> </div> </div> </section> <section id="blog-related-posts" class="border-t border-gray-100 bg-gray-50/60 py-16 dark:border-gray-800 dark:bg-gray-900/40 md:py-20" data-astro-cid-4sn4zg3r> <div class="site-container max-w-6xl" data-astro-cid-4sn4zg3r> <div class="mb-8 flex items-end justify-between gap-4" data-astro-cid-4sn4zg3r> <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100 md:text-3xl" data-astro-cid-4sn4zg3r>More like this</h2> <a href="/blog/" data-ta="blog-related-all" class="CTA hidden text-sm font-semibold text-purple-700 transition-colors hover:text-purple-900 dark:text-purple-400 dark:hover:text-purple-300 md:inline-flex" data-astro-cid-4sn4zg3r>
