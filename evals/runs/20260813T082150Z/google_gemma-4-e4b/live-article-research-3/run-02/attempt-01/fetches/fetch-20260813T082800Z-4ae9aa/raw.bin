<path fill-rule="evenodd" clip-rule="evenodd" d="M7.75109 7C8.16341 7 8.49767 7.33425 8.49767 7.74658C8.49767 8.12159 8.219 8.43151 7.85744 8.48056L7.75272 8.4873L6.98434 8.48782L6.87594 8.491L6.74767 8.5C6.10167 8.5 5.57033 8.99096 5.50644 9.6201L5.5 9.74767V17.25C5.5 17.8972 5.99187 18.4295 6.62219 18.4935L6.75 18.5H14.2477C14.8949 18.5 15.4272 18.0081 15.4912 17.3778L15.4977 16.25C15.4977 15.8358 15.8335 15.5 16.2477 15.5C16.6619 15.5 16.9977 15.8358 16.9977 16.25V17.25C16.9977 18.7125 15.856 19.9084 14.4152 19.995L14.2477 20H6.75C5.28747 20 4.0916 18.8583 4.00502 17.4175L4 17.25V9.74767C4 8.23017 5.23017 7 6.74767 7H7.75109ZM19.2477 4C19.6619 4 19.9977 4.33579 19.9977 4.75V11.75C19.9977 12.1642 19.6619 12.5 19.2477 12.5C18.8335 12.5 18.4977 12.1642 18.4977 11.75V6.55902L11.9998 13.0586C11.7069 13.3514 11.2321 13.3514 10.9392 13.0585C10.6463 12.7656 10.6463 12.2907 10.9392 11.9978L17.4362 5.5H12.2477C11.8335 5.5 11.4977 5.16421 11.4977 4.75C11.4977 4.33579 11.8335 4 12.2477 4H19.2477Z" fill="currentColor"/>
