</style>
<style id="ponyo-peter-style-inline-css">
.wp-block-ponyo-peter.most-popular>*{overflow:hidden;position:relative;z-index:0}.wp-block-ponyo-peter{--subSectionPadding:1.25rem;--leftPadding:2rem;border-right:0;display:grid;gap:0;grid-row:span 8;grid-template-rows:subgrid}@media screen and (max-width:61.1875rem){.wp-block-ponyo-peter{border-top:1px solid var(--borderColor);--subSectionPadding:1.25rem;--leftPadding:1.25rem}}@media screen and (min-width:26.5625rem){.wp-block-ponyo-peter{border-right:1px solid var(--borderColor)}.wp-block-ponyo-peter:nth-child(2n){border-right:0}}@media screen and (min-width:61.25rem){.wp-block-ponyo-peter:nth-child(2n){border-right:1px solid var(--borderColor)}.wp-block-ponyo-peter:nth-child(4){border-right:0}}.wp-block-ponyo-peter>*{background:var(--backgroundColor);padding-bottom:var(--subSectionPadding);padding-left:var(--leftPadding);padding-right:var(--leftPadding)}.wp-block-ponyo-peter .most-popular-tag{display:flex;min-height:1.75rem;padding:0}.wp-block-ponyo-peter .most-popular-tag .wp-block-ponyo-text{background-color:var(--tooltipBackground);color:var(--copyColor);display:flex;flex:1;flex-direction:column;font-family:Inter,Helvetica,Arial,sans-serif;font-size:.75rem;font-weight:400;font-weight:700;justify-content:center;letter-spacing:-.15px;line-height:130%;max-width:72ch;text-align:center}.wp-block-ponyo-peter .title{padding-top:.75rem}.wp-block-ponyo-peter .title .wp-block-ponyo-heading,.wp-block-ponyo-peter .title .wp-block-ponyo-text{font-size:1rem;font-weight:500;letter-spacing:-.2px;line-height:140%;max-width:72ch}.wp-block-ponyo-peter .title a{text-decoration:underline}.wp-block-ponyo-peter .price .annually .wp-block-ponyo-text,.wp-block-ponyo-peter .price .monthly .wp-block-ponyo-text,.wp-block-ponyo-peter .price .wp-block-ponyo-heading{font-family:Repro,Helvetica,Arial,sans-serif;font-size:3rem;font-weight:500;letter-spacing:-.6px;line-height:120%;max-width:50ch}.wp-block-ponyo-peter .price .per-user .wp-block-ponyo-text{font-family:Inter,Helvetica,Arial,sans-serif;font-family:Repro,Helvetica,Arial,sans-serif;font-size:1.125rem;font-weight:400;font-weight:500;letter-spacing:-.225px;line-height:140%;max-width:72ch}.wp-block-ponyo-peter .body-text{font-size:1rem;letter-spacing:-.2px;line-height:140%;max-width:72ch}.wp-block-ponyo-peter .buttons{display:flex;flex-direction:column;gap:.5rem}.wp-block-ponyo-peter .buttons .wp-block-ponyo-button{justify-content:center;width:100%}.wp-block-ponyo-peter .list .heading{align-items:center;display:flex;gap:.5rem}.wp-block-ponyo-peter .list .heading .wp-block-ponyo-heading,.wp-block-ponyo-peter .list .heading .wp-block-ponyo-text,.wp-block-ponyo-peter .list .subtitle{font-family:Inter,Helvetica,Arial,sans-serif;font-size:.875rem;font-weight:400;letter-spacing:-.15px;line-height:130%;max-width:72ch}.wp-block-ponyo-peter .list .subtitle{color:var(--copyColor2);padding-top:.5rem}.wp-block-ponyo-peter .list .wp-block-ponyo-bernard{padding-top:1rem}.wp-block-ponyo-peter .wp-block-ponyo-norman h4{color:var(--copyColor2)}.wp-block-ponyo-peter.style__rounded{background:#fff;border:1px solid #e7eaef;border-radius:14px;overflow:hidden}.wp-block-ponyo-peter.style__rounded>*{background:none}.wp-block-ponyo-peter.style__rounded .title .wp-block-ponyo-heading,.wp-block-ponyo-peter.style__rounded .title .wp-block-ponyo-text{font-size:1.125rem}.wp-block-ponyo-peter.style__rounded .title a{font-weight:700}.wp-block-ponyo-peter.style__rounded .subtitle{margin-bottom:.5rem;padding-top:.5rem}.wp-block-ponyo-peter.style__rounded .subtitle *{color:#566581;font-family:Inter,Helvetica,Arial,sans-serif;font-size:.875rem;font-weight:400;letter-spacing:-.15px;line-height:130%;max-width:72ch}.wp-block-ponyo-peter.style__rounded .body-text .wp-block-ponyo-text{font-size:1rem}.wp-block-ponyo-peter.style__rounded .list>.wp-block-ponyo-heading,.wp-block-ponyo-peter.style__rounded .list>.wp-block-ponyo-text{font-weight:500}.wp-block-ponyo-peter.style__emphasize{background:linear-gradient(160deg,#fff,#f0f4ff 25%,#f0f4ff 75%,#fff);border:1px solid #aac4f8;box-shadow:0 4px 20px 0 rgba(13,77,242,.2)}.wp-block-ponyo-peter.style__emphasize:has(.style__emphasize)>*{background-color:var(--backgroundColor)}.wp-block-ponyo-peter.style__emphasize:has(.style__emphasize) .style__emphasize{background-color:unset;border-top:1px solid #aac4f8;padding-top:1.5rem}.wp-block-ponyo-peter.display__flex{display:flex;flex-direction:column}.wp-block-ponyo-peter-card>.container{display:flex;flex-direction:column;justify-content:flex-end;padding-top:.75rem}.wp-block-ponyo-sheila .annually,.wp-block-ponyo-sheila .monthly{display:none;visibility:hidden}.wp-block-ponyo-sheila.annually .annually,.wp-block-ponyo-sheila.monthly .monthly{display:revert;visibility:visible}.wp-block-ponyo-peter .organism{background:unset;border:0;padding:0}
