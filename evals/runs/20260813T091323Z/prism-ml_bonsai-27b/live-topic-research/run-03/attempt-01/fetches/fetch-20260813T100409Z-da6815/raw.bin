<div id="A7.T4.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:389.5pt;height:62.4pt;vertical-align:-29.1pt;"><span class="ltx_transformed_inner" style="transform:translate(-35.1pt,5.6pt) scale(0.847271461735573,0.847271461735573) ;">
