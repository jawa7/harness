<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(b) </span>LUE<sub id="A4.F21.sf2.3" class="ltx_sub"><span id="A4.F21.sf2.3.1" class="ltx_text ltx_font_italic">x</span></sub></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
