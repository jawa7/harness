<figure id="S4.F3.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2605.00737v1/Qwen_Qwen3-30B-A3B-Instruct-2507_perceived_need_vs_utility_matrix.svg" id="S4.F3.sf3.g1" class="ltx_graphics ltx_centering ltx_img_square" width="548" height="457"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(c) </span>Qwen3-IT</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_many">
<figure id="S4.F3.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2605.00737v1/google_gemma-3-27b-it_perceived_need_vs_utility_matrix.svg" id="S4.F3.sf4.g1" class="ltx_graphics ltx_centering ltx_img_square" width="548" height="457"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(d) </span>Gemma3-IT</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_many">
<figure id="S4.F3.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2605.00737v1/mistralai_Mistral-Small-3.1-24B-Instruct-2503_perceived_need_vs_utility_matrix.svg" id="S4.F3.sf5.g1" class="ltx_graphics ltx_centering ltx_img_square" width="548" height="457"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(e) </span>Mistral-IT</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_many">
