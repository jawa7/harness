window.adthrive)),e.ClsDisableAds=l,e})({});</script><style id="wp-custom-css">
div.latn, table.latn, table.thb {
    border-width: 0px;
    border-color: #ffffff;
}
#content {
    border: 0px solid #ccc;
}
#custom_html-3 {
	min-height:300px;
}

.youtube-video {
  aspect-ratio: 16 / 9;
  width: 100%;
}


/* Ninja Forms */
.nf-form-cont { max-width: 480px; }

.nf-form-cont .nf-field-container { margin-bottom: 18px; }

.nf-form-cont .nf-field-label label {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 6px;
}

.nf-form-cont .nf-field-element input[type=text],
.nf-form-cont .nf-field-element input[type=email] {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #d4d4d8;
  border-radius: 6px;
  font-size: 16px;          /* below 16px, iOS zooms on focus */
  background: #fff;
  box-shadow: none;
}

.nf-form-cont .nf-field-element input:focus {
  border-color: #2563eb;
  outline: 2px solid rgba(37, 99, 235, 0.2);
}


.nf-form-cont input[type=submit].nf-element {
  display: block;
  margin: 20 auto;
  width: auto;
  height: auto;
  background-color: #E8A838;
  color: #ffffff;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 20px;
  font-weight: 700;
  line-height: 1.2;
  padding: 18px 52px;
  border: 0;
  border-radius: 50px;
  letter-spacing: 0.01em;
  cursor: pointer;
  -webkit-appearance: none;    /* iOS forces its own button chrome otherwise */
  appearance: none;
  transition: background-color .15s ease;
}

.nf-form-cont input[type=submit].nf-element:hover {
  background-color: #d0942e;
}

.nf-form-cont input[type=submit].nf-element:focus-visible {
  outline: 3px solid rgba(232, 168, 56, 0.45);
  outline-offset: 2px;
}
</style>
