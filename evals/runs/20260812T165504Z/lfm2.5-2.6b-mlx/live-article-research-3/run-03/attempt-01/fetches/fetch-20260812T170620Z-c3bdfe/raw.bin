ude/\",\"locale\":\"$undefined\",\"localeCookie\":false,\"className\":\"text-header-text text-sm hover:text-text/50\",\"children\":\"Claude\",\"prefetch\":false}]\n71:[\"$\",\"$L59\",\"Bedrock\",{\"ref\":\"$undefined\",\"href\":\"https://dev.classmethod.jp/en/tags/amazon-bedrock/\",\"locale\":\"$undefined\",\"localeCookie\":false,\"className\":\"text-header-text text-sm hover:text-text/50\",\"children\":\"Bedrock\",\"prefetch\":false}]\n72:[\"$\",\"$L59\",\"Google Cloud\",{\"ref\":\"$undefined\",\"href\":\"https://dev.classmethod.jp/en/tags/google-cloud/\",\"locale\":\"$undefined\",\"localeCookie\":false,\"className\":\"text-header-text text-sm hover:text-text/50\",\"children\":\"Google Cloud\",\"prefetch\":false}]\n73:[\"$\",\"$L59\",\"Azure\",{\"ref\":\"$undefined\",\"href\":\"https://dev.classmethod.jp/en/tags/azure/\",\"locale\":\"$undefined\",\"localeCookie\":false,\"className\":\"text-header-text text-sm hover:text-text/50\",\"children\":\"Azure\",\"prefetch\":false}]\n74:[\"$\",\"$L59\",\"Seminar\",{\"ref\":\"$undefined\",\"href\":\"https://events.classmethod.jp/seminar/\",\"locale\":\"$undefined\",\"localeCookie\":false,\"className\":\"text-header-text text-sm hover:text-text/50\",\"children\":\"Seminar\",\"prefetch\":false}]\n75:[\"$\",\"$L59\",\"Job fair\",{\"ref\":\"$undefined\",\"href\":\"https://events.classmethod.jp/meetup/\",\"locale\":\"$undefined\",\"localeCookie\":false,\"className\":\"text-header-text text-sm hover:text-text/50\",\"children\":\"Job fair\",\"prefetch\":false}]\n76:[\"$\",\"$L59\",\"study-club\",{\"ref\":\"$undefined\",\"href\":\"https://events.classmethod.jp/study-club/\",\"locale\":\"$undefined\",\"localeCookie\":false,\"className\":\"text-header-text text-sm hover:text-text/50\",\"children\":\"study-club\",\"prefetch\":false}]\n77:[\"$\",\"$L59\",\"Case study\",{\"ref\":\"$undefined\",\"href\":\"https://classmethod.jp/cases/?utm_source=dev.classmethod.jp\u0026utm_medium=blog\u0026utm_campaign=nav\u0026utm_content=cases\",\"locale