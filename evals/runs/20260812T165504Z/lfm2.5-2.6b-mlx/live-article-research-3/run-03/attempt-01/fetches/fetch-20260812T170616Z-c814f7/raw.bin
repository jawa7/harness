<script type="text/javascript" id="jdh-prompt-copy-blocks-js-after">
/* <![CDATA[ */
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('pre.wp-block-code').forEach(function(pre) {
        var code = pre.querySelector('code');
        if (!code || pre.querySelector('.prompt-copy-btn')) return;

        var isPromptTemplate = pre.classList.contains('is-prompt-template');
        var defaultLabel = isPromptTemplate ? 'Copy prompt' : 'Copy';

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'prompt-copy-btn';
        btn.textContent = defaultLabel;

        btn.addEventListener('click', function() {
            var text = code.textContent;
            if (!navigator.clipboard || !navigator.clipboard.writeText) {
                btn.textContent = 'Copy unsupported';
                setTimeout(function() { btn.textContent = defaultLabel; }, 1600);
                return;
            }
            navigator.clipboard.writeText(text).then(function() {
                btn.textContent = 'Copied';
                btn.classList.add('is-copied');
                setTimeout(function() {
                    btn.textContent = defaultLabel;
                    btn.classList.remove('is-copied');
                }, 1600);
            }).catch(function() {
                btn.textContent = 'Copy failed';
                setTimeout(function() { btn.textContent = defaultLabel; }, 1600);
            });
        });

        pre.appendChild(btn);
    });
});
//# sourceURL=jdh-prompt-copy-blocks-js-after
/* ]]> */
</script>
<script type="text/javascript" src="https://www.jdhodges.com/wp-includes/js/comment-reply.min.js?ver=6.9.7" id="comment-reply-js" async="async" data-wp-strategy="async" fetchpriority="low"></script>
</body>
