    font-weight: 600;
}
.yarpp-jdh-compact ol.yarpp-jdh-list li a {
    color: #2c5282;
    text-decoration: none;
    font-weight: 500;
}
.yarpp-jdh-compact ol.yarpp-jdh-list li a:hover {
    color: #1a365d;
    text-decoration: underline;
}
/* Outer YARPP container: zero its margins so our inner block owns spacing */
.yarpp-related,
.yarpp-related-website { margin: 0 !important; }
@media (max-width: 600px) {
    .yarpp-jdh-compact { font-size: 13px; line-height: 1.7; }
    .yarpp-jdh-compact .yarpp-jdh-label { display: block; margin-bottom: 0.25em; }
}

/* ---- Reader-request form (flatter, tighter) ---- */
.jdh-reader-request {
    background: #fafafa;
    border: 1px solid #e5e7eb;
    border-left: 2px solid #a78bfa;
    border-radius: 0 6px 6px 0;
    padding: 1.2em 1.5em 1.1em;
    margin: 1.5em 0 1em;
}
.jdh-reader-request h3#jdh-rr-heading {
    margin: 0 0 0.4em;
    font: 600 18px/1.25 system-ui, -apple-system, sans-serif;
    color: #1f2937;
    padding: 0;
    border: 0;
}
.jdh-reader-request .jdh-rr-intro {
    font-size: 15px;
    line-height: 1.55;
    color: #374151;
    margin: 0 0 1em;
}
.jdh-reader-request .jdh-rr-field {
    margin: 0 0 0.65em;
}
.jdh-reader-request .jdh-rr-field label {
    display: block;
    font: 500 13px/1.2 system-ui, -apple-system, sans-serif;
    letter-spacing: 0;
    text-transform: none;
    color: #374151;
    margin-bottom: 0.3em;
}
.jdh-reader-request .jdh-rr-field-name label {
    color: #6b7280;
    font-weight: 400;
}
.jdh-reader-request .jdh-rr-field input[type="text"],
.jdh-reader-request .jdh-rr-field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.55em 0.75em;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-size: 15px;
    font-family: inherit;
    background: #fff;
    color: #111827;
}
.jdh-reader-request .jdh-rr-field input[type="text"]:focus,
.jdh-reader-request .jdh-rr-field textarea:focus {
    outline: 0;
    border-color: #a78bfa;
    box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.18);
}
.jdh-reader-request .jdh-rr-field textarea {
    resize: vertical;
    min-height: 4em;
    line-height: 1.5;
}
.jdh-reader-request .jdh-rr-field textarea::placeholder,
.jdh-reader-request .jdh-rr-field input::placeholder {
    color: #9ca3af;
}
.jdh-reader-request .jdh-rr-hp {
    position: absolute !important;
    left: -9999px !important;
    top: -9999px !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
}
.jdh-reader-request .jdh-rr-submit {
    margin: 0.7em 0 0;
}
.jdh-reader-request .jdh-rr-button {
    background: #7c3aed;
    color: #fff;
    border: 0;
    padding: 0.65em 1.75em;
    font: 600 14px/1 system-ui, -apple-system, sans-serif;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s ease;
}
.jdh-reader-request .jdh-rr-button:hover {
    background: #6d28d9;
}
.jdh-reader-request .jdh-rr-button:disabled {
    opacity: 0.6;
    cursor: wait;
}
.jdh-reader-request .jdh-rr-status {
    margin: 0.6em 0 0;
    font-size: 14px;
}
.jdh-reader-request .jdh-rr-status:empty {
    margin: 0;
}
.jdh-reader-request .jdh-rr-status.ok {
    color: #065f46;
    font-weight: 500;
}
.jdh-reader-request .jdh-rr-status.err {
    color: #991b1b;
}
.jdh-reader-request .jdh-rr-thanks {
    padding: 0.2em 0;
}
.jdh-reader-request .jdh-rr-thanks-title {
    margin: 0 0 0.3em;
    font: 600 17px/1.3 system-ui, -apple-system, sans-serif;
    color: #065f46;
}
.jdh-reader-request .jdh-rr-thanks-body {
    margin: 0;
    font-size: 14px;
    color: #4b5563;
    line-height: 1.55;
}
@media (max-width: 600px) {
    .jdh-reader-request { padding: 1.2em 1.25em; margin: 1.8em 0 1.2em; }
    .jdh-reader-request h3#jdh-rr-heading { font-size: 16px; }
    .jdh-reader-request .jdh-rr-intro { font-size: 14px; }
}

/* ---- Promoted reader Q&A attribution block ---- */
.jdh-reader-q {
    border-left: 3px solid #a78bfa;
    background: #faf5ff;
    padding: 1.1em 1.35em;
    margin: 1.6em 0;
    border-radius: 0 6px 6px 0;
}
.jdh-reader-q .jdh-reader-q-who {
    margin: 0 0 0.4em;
    font: 600 12px/1 system-ui, -apple-system, sans-serif;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: #6d28d9;
}
.jdh-reader-q .jdh-reader-q-text {
    margin: 0;
    padding: 0;
    border: 0;
    font-style: italic;
    font-size: 16px;
    line-height: 1.55;
    color: #2d3748;
}

/* ---- Tightened update disclaimer ---- */
.jdh-update-note {
    margin: 0.6em 0 1em;
    color: #6b7280;
}
.jdh-update-note small {
    font-size: 12px;
    line-height: 1.5;
}
.jdh-update-note small a {
    color: #2c5282;
}

/* ---- Inline comment author + timestamp (sitewide, works with Zeeflow theme) ---- */
/* Tighter inter-comment spacing (theme defaults to 2em top margin + 2em top padding) */
.commentlist li.comment {
    margin: 1.2em 0 0;
    padding: 1.1em 0 0;
}
.commentlist li.comment:first-child {
    margin-top: 0.4em;
    padding-top: 0.5em;
    border-top: 0;
}

/* Smaller avatar with rounded corners */
.commentlist .comment-author img.avatar {
    width: 40px;
    height: 40px;
    margin-right: 0.8em;
    margin-top: 0.2em;
    border-radius: 4px;
}

/* Collapse comment-author wrapper div so the name and timestamp share a line */
.commentlist .comment-body .comment-author.vcard {
    display: inline;
}

/* Inline the author name + meta timestamp */
.commentlist .comment-author .fn {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 15px;
    font-weight: 600;
    font-style: normal;
    padding: 0;
    display: inline;
    background: none;
}
.commentlist .comment-author .fn,
.commentlist .comment-author .fn a,
.commentlist .comment-author .fn a:link,
.commentlist .comment-author .fn a:visited {
    color: #1f2937;
    text-decoration: none;
}

.commentlist .comment-meta {
    display: inline;
    margin-bottom: 0.5em;
    margin-left: 0.4em;
    font-size: 12px;
    line-height: 1.4;
}
.commentlist .comment-meta::before {
    content: "\00b7\00a0";
    color: #d1d5db;
    font-weight: 600;
    margin-right: 0.15em;
}
.commentlist .comment-meta a,
.commentlist .comment-meta a:link,
.commentlist .comment-meta a:visited {
    color: #9ca3af;
    text-decoration: none;
}
.commentlist .comment-meta a:hover {
    color: #4b5563;
    text-decoration: underline;
}

/* Body paragraph tightening inside comments */
.commentlist .comment-body > p {
    margin: 0.5em 0 0.6em;
}
.commentlist .comment-body > p.comment-awaiting-moderation {
    display: block;
    margin: 0.3em 0 0.5em;
    font-size: 12px;
    color: #b45309;
    font-style: italic;
}
.commentlist .reply {
    margin-top: 0.2em;
}

/* Comments heading tighter + sans font to match our overall palette */
#comments .comments-title {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #1f2937;
    padding: 0.3em 0;
    margin: 0 0 0.5em;
    border-bottom: 1px solid #e5e7eb;
}

/* ---- Sitewide spacing compression for single posts (theme default is generous) ---- */
body.single-post .type-post {
    margin-bottom: 1.2em;
    padding-bottom: 1.2em;
}
body.single-post #comments {
    margin: 0 0 1.5em 0;
}
body.single-post .commentlist {
    margin: 0.8em 0 0.8em;
}
body.single-post .postinfo {
    padding: 0.4em 0.5em;
    margin-top: 0.3em;
}
body.single-post .postinfo .meta-category,
body.single-post .postinfo .meta-tags {
    padding: 0.3em 0;
}

/* .jdh-affiliate-box: tighter vertical margins (sitewide) */
body.single-post .jdh-affiliate-box {
    margin: 1em 0;
}
/*# sourceURL=jdh-reader-requests-inline-css */
</style>
<style id='jdh-prompt-copy-blocks-inline-css' type='text/css'>
/* Default styling for plain code blocks (shell, config, etc) */
pre.wp-block-code {
    position: relative;
    padding: 1rem 4.5rem 1rem 1rem; /* extra right pad for copy btn */
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #f8fafc;
    overflow: auto;
    margin: 1.5em 0;
}

pre.wp-block-code code {
    display: block;
    white-space: pre-wrap;
    word-break: break-word;
    font: 500 14px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: #14202b;
}

.prompt-copy-btn {
    position: absolute;
    top: .55rem;
    right: .55rem;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    background: #fff;
    color: #475569;
    padding: .35rem .7rem;
    font: 600 12px/1 system-ui, -apple-system, sans-serif;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    line-height: 1;
}

.prompt-copy-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
}

.prompt-copy-btn.is-copied {
    background: #0f5ea8;
    border-color: #0f5ea8;
    color: #fff;
}

/* Branded prompt-template card style — opt-in via class on <pre> */
pre.wp-block-code.is-prompt-template {
    padding: 3rem 1rem 1rem;
    border-color: #d9e2ec;
    background: linear-gradient(180deg, #fbfdff 0%, #f5f7fa 100%);
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
    border-radius: 14px;
}

pre.wp-block-code.is-prompt-template::before {
    content: "Prompt template";
    position: absolute;
    top: .8rem;
    left: 1rem;
    font: 600 11px/1 system-ui, -apple-system, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #66758a;
}

pre.wp-block-code.is-prompt-template code {
    font-size: 15px;
    line-height: 1.65;
}

pre.wp-block-code.is-prompt-template .prompt-copy-btn {
    top: .7rem;
    right: .75rem;
    padding: .45rem .8rem;
    font-size: 13px;
    color: #0f5ea8;
    border-color: #c7d2de;
}
/*# sourceURL=jdh-prompt-copy-blocks-inline-css */
</style>
