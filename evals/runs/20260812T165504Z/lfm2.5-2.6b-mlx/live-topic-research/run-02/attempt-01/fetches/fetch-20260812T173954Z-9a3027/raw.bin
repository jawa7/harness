<div class="post-content-wrapper pt-[50px] sm:pt-[60px] md:pt-[80px] pb-[60px] md:pb-[80px] lg:pb-[100px]">
    <div class="outer">
        <div class="container">
            <div class="pb-[40px]">
                <a href="https://blog.promptlayer.com" class="back-button inline-flex items-center gap-2 px-4 py-2 rounded-md  mb-8">
                    
<svg width="20" height="16" viewBox="0 0 20 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M19 8.99976C19.5523 8.99976 20 8.55204 20 7.99976C20 7.44747 19.5523 6.99976 19 6.99976L19 8.99976ZM0.292892 7.29265C-0.0976315 7.68318 -0.0976314 8.31634 0.292893 8.70686L6.65686 15.0708C7.04738 15.4613 7.68054 15.4613 8.07107 15.0708C8.46159 14.6803 8.46159 14.0471 8.07107 13.6566L2.41421 7.99976L8.07107 2.3429C8.46159 1.95238 8.46159 1.31921 8.07107 0.928689C7.68054 0.538165 7.04738 0.538165 6.65685 0.928689L0.292892 7.29265ZM19 6.99976L1 6.99976L1 8.99976L19 8.99976L19 6.99976Z" fill="currentColor"/>
