                        <script>
                            let navItems = document.querySelectorAll('.menu li');
                            let prevItem, subItems = [];

                            navItems.forEach(item => {
                                let label = item.children[0].textContent.trim();

                                if (label.startsWith('--')) {
                                    subItems.push({
                                        label: label.replace('-- ', ''),
                                        link: item.firstElementChild.getAttribute('href'),
                                        classes: item.firstElementChild.classList
                                    });
                                } else {
                                    if (subItems.length) {
                                        appendSubNav(prevItem, subItems);
                                    }
                                    prevItem = item;
                                    subItems = [];
                                }
                            });

                            if (subItems.length) {
                                appendSubNav(prevItem, subItems);
                            }

                            function appendSubNav(prevItem, subItems) {
                                let subNavHTML = `
                                    <span class="nav-trigger">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.171l4.95-4.95l1.414 1.415L12 16L5.636 9.636L7.05 8.222z"/></svg>
                                    </span>
                                    <div class="secondary-nav">
                                        <ul class="nav">
                                            ${subItems.map(sub => 
                                                `<li><a class="${sub.classes}" href="${sub.link}">${sub.label}</a></li>`
                                            ).join('')}
                                        </ul>
                                    </div>`;

                                prevItem.innerHTML += subNavHTML;
                                prevItem.classList.remove('nav-current');
                                prevItem.classList.add('subnav', 'nav-wrapper');
                            }

                            navItems.forEach(item => {
                                if (item.firstElementChild.textContent.startsWith('--')) item.remove();
                            });

                            // Replacing jQuery with Vanilla JavaScript
                            document.addEventListener('DOMContentLoaded', function () {
                                // Toggle mobile dropdown
                                document.querySelectorAll('.nav-trigger').forEach(trigger => {
                                    trigger.addEventListener('click', function (e) {
                                        e.stopPropagation();
                                        const parent = this.parentElement;
                                        parent.classList.toggle("active");
                                        parent.querySelector('.secondary-nav').classList.toggle("active");
                                    });
                                });

                                // Prevent clicks inside the dropdown from closing it
                                document.querySelectorAll('.nav').forEach(nav => {
                                    nav.addEventListener('click', function (e) {
                                        e.stopPropagation();
                                    });
                                });
                            });
                        </script>
                    </ul>
