u003ca data-link=\"ext\" target=\"_blank\" rel=\"noreferrer\" href=\"https://www.ceskenoviny.cz/zpravy/hokejiste-trince-hradce-olomouce-a-sparty-vstoupili-do-pripravy-vyhrami/2860953\"\u003eeské noviny\u003c/a\u003e) \u003c!--Poslední typografie: Marie Dámková 11. 8. 2026 21:40:08--\u003e\u003c/p\u003e\n","content":"","id":2152925,"url":"https://denikn.cz/minuta/2152925/","published_at":"2026-08-11T21:40:18+02:00","tags":[{"type":"tag","id":454,"slug":"hokej","url":"https://denikn.cz/tag/hokej/","name":"Hokej","image":{"id":454,"excerpt":"","sizes":[{"width":200,"height":134,"url":"https://denikn.cz/api/feature/tag/454/?w=200\u0026h=134"},{"width":720,"height":480,"url":"https://denikn.cz/api/feature/tag/454/?w=720\u0026h=480"},{"width":1600,"height":1067,"url":"https://denikn.cz/api/feature/tag/454/?w=1600\u0026h=1067"},{"width":2400,"height":1600,"url":"https://denikn.cz/api/feature/tag/454/?w=2400\u0026h=1600"}]},"icon":{"id":1965340,"excerpt":"Zahajovací ceremoniál ZOH na milánském stadionu San Siro. Foto: Ashley Landis / AP / ČTK","sizes":[{"width":15,"height":15,"url":"https://img.novydenik.com/wp-static/2026/02/IMG1755jpeg.jpg?w=15\u0026h=15\u0026fit=crop\u0026fm=png"},{"width":20,"height":20,"url":"https://img.novydenik.com/wp-static/2026/02/IMG1755jpeg.jpg?w=20\u0026h=20\u0026fit=crop\u0026fm=png"},{"width":30,"height":30,"url":"https://img.novydenik.com/wp-static/2026/02/IMG1755jpeg.jpg?w=30\u0026h=30\u0026fit=crop\u0026fm=png"},{"width":40,"height":40,"url":"https://img.novydenik.com/wp-static/2026/02/IMG1755jpeg.jpg?w=40\u0026h=40\u0026fit=crop\u0026fm=png"},{"width":60,"height":60,"url":"https://img.novydenik.com/wp-static/2026/02/IMG1755jpeg.jpg?w=60\u0026h=60\u0026fit=crop\u0026fm=png"},{"width":80,"height":80,"url":"https://img.novydenik.com/wp-static/2026/02/IMG1755jpeg.jpg?w=80\u0026h=80\u0026fit=crop\u0026fm=png"},{"width":256,"height":256,"url":"https://img.novydenik.com/wp-static/2026/02/IMG1755jpeg.jpg?w=256\u0026h=256\u0026fit=crop\u0026fm=png"}]},"excerpt":"","tags":[],"followable":true,"settings":[],"featured_text":"","parent_category":13,"url_spotify":null,"url_applepodcasts":null,"url_youtube":null,"url_more":null}],"image":null,"title":"","embed":[],"seen":false,"forceNotSeen":false,"published_at_date":1786477218000,"isImportant":false,"isCollapsed":false,"shouldHideImageOnHome":false,"excerptOriginal":"\u003cp\u003e\u003cstrong\u003e Hokejisté Třince, Hradce Králové, Olomouce a Sparty vstoupili vítězně do přípravy před blížícím se startem extraligy.\u003c/strong\u003e Oceláři porazili prvoligový Frýdek Místek 6:2, Mountfield přehrál Jihlavu 3:0 a Sparta zdolala jiného zástupce druhé nejvyšší soutěže Litoměřice 4:2. Hanáci zvítězili nad Vítkovicemi 2:0. (Č\u003ca data-link=\"ext\" target=\"_blank\" rel=\"noreferrer\" href=\"https://www.ceskenoviny.cz/zpravy/hokejiste-trince-hradce-olomouce-a-sparty-vstoupili-do-pripravy-vyhrami/2860953\"\u003eeské noviny\u003c/a\u003e) \u003c!--Poslední typografie: Marie Dámková 11. 8. 2026 21:40:08--\u003e\u003c/p\u003e\n","hasReadMore":false},{"excerpt":"\u003cp\u003e\u003cstrong\u003eVýškař Jan Štefela ztroskotal na mistrovství Evropy v kvalifikaci.\u003c/strong\u003e Bronzový medailista z loňského světového šampionátu v Tokiu zvládl v Birminghamu napodruhé 219 centimetrů, laťku ve výšce 223 centimetrů už nepřekonal. \u003c/p\u003e\n","content":"\u003cp\u003eV celkovém pořadí se vinou horšího zápisu zařadil na dělené čtrnácté místo a poprvé v kariéře se na velké seniorské akci do finálové dvanáctky nedostal. (\u003ca data-link=\"ext\" target=\"_blank\" rel=\"noreferrer\" href=\"https://www.ceskenoviny.cz/zpravy/stefela-neuspel-na-me-v-kvalifikaci-vyskaru-/2860639\"\u003eČeské noviny\u003c/a\u003e)\u003c!--Poslední typografie: Kateřina Sikorová 11. 8. 2026 16:24:42--\u003e\u003c/p\u003e\n","id":2152559,"url":"https://denikn.cz/minuta/2152559/","published_at":"2026-08-11T15:52:27+02:00","tags":[],"image":null,"title":"","embed":[],"seen":false,"forceNotSeen":false,"published_at_date":1786456347000,"isImportant":false,"isCollapsed":false,"shouldHideImageOnHome":false,"excerptOriginal":"\u003cp\u003e\u003ca data-link=\"int\" href=\"https://denikn.cz/minuta/2152559/?ref=mwat\"\u003eVýškař Jan Štefela ztroskotal na mistrovství Evropy v kvalifikaci.\u003c/a\u003e Bronzový medailista z loňského světového šampionátu v Tokiu zvládl v Birminghamu napodruhé 219 centimetrů, laťku ve výšce 223 centimetrů už nepřekonal. \u003c/p\u003e\n","hasReadMore":true,"readMoreCountOfWords":29},{"excerpt":"\u003cp\u003e\u003ca data-link=\"int\" href=\"https://denikn.cz/2151275/atletika-je-esteticka-ne-sexisticka-nova-pravidla-meni-televizni-zabery-na-zeny-ve-sportu/?ref=mwat\"\u003ePříručka Evropské vysílací unie Raising the Bar má minimalizovat sexistické útoky na atletky ve vysílání i na sociálních sítích.\u003c/a\u003e Co nová pravidla vysílání atletiky skutečně mění? Zmizely choulostivější záběry na ženy, třeba pohled zepředu při flopovém stylu ve skoku do výšky. Divák si změny téměř nevšimne, sportovkyně ale nemusejí být ve stresu. \u003c!--Poslední typografie: Kateřina Sikorová 11. 8. 2026 15:59:50--\u003e\u003c/p\u003e\n","content":"","id":2152380,"url":"https://denikn.cz/minuta/2152380/","published_at":"2026-08-11T12:57:45+02:00","tags":[{"type":"tag","id":2478,"slug":"atletika","url":"https://denikn.cz/tag/atletika/","name":"Atletika","image":{"id":2478,"excerpt":"","sizes":[{"width":200,"height":134,"url":"https://denikn.cz/api/feature/tag/2478/?w=200\u0026h=134"},{"width":720,"height":480,"url":"https://denikn.cz/api/feature/tag/2478/?w=720\u0026h=480"},{"width":1600,"height":1067,"url":"https://denikn.cz/api/feature/tag/2478/?w=1600\u0026h=1067"},{"width":2400,"height":1600,"url":"https://denikn.cz/api/feature/tag/2478/?w=2400\u0026h=1600"}]},"icon":{"id":2151396,"excerpt":"Jamajská atletka Lamara Distin skáče do výšky v soutěži žen na 32. ročníku atletického závodu Banskobystrická laťka. Foto: TASR/Profimedia","sizes":[{"width":15,"heigh