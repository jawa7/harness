erpt":"\u003cp\u003e\u003cstrong\u003eBritská Fotbalová asociace (FA) jako první oznámila, že stahuje podporu znovuzvolení Gianniho Infantina v příští volbě prezidenta FIFA.\u003c/strong\u003e Ta bude příští rok. Oznámení přišlo po nevoli, kterou vyvolal plán prodat část mistrovství světa, a kontroverzích spojených s nedávným MS. (\u003ca data-link=\"ext\" target=\"_blank\" rel=\"noreferrer\" href=\"https://x.com/i/status/2084203535596396940\"\u003eSky\u003c/a\u003e) \u003c!--Poslední typografie: Sylvie Zbraňková 3. 8. 2026 13:29:26--\u003e\u003c/p\u003e\n","content":"","id":2144845,"url":"https://denikn.cz/minuta/2144845/","published_at":"2026-08-03T13:00:59+02:00","tags":[{"type":"tag","id":304,"slug":"fotbal","url":"https://denikn.cz/tag/fotbal/","name":"Fotbal","image":{"id":304,"excerpt":"","sizes":[{"width":200,"height":134,"url":"https://denikn.cz/api/feature/tag/304/?w=200\u0026h=134"},{"width":720,"height":480,"url":"https://denikn.cz/api/feature/tag/304/?w=720\u0026h=480"},{"width":1600,"height":1067,"url":"https://denikn.cz/api/feature/tag/304/?w=1600\u0026h=1067"},{"width":2400,"height":1600,"url":"https://denikn.cz/api/feature/tag/304/?w=2400\u0026h=1600"}]},"icon":{"id":2131522,"excerpt":"Šéf FIFA Gianni Infantino a Donald Trump předávali trofej vítězi. Foto: Heuler Andrey, DiaEsportivo / imago sportfotodienst / ČTK","sizes":[{"width":15,"height":15,"url":"https://img.novydenik.com/wp-static/2026/07/profimedia-1117498488.jpg?w=15\u0026h=15\u0026fit=crop\u0026fm=png"},{"width":20,"height":20,"url":"https://img.novydenik.com/wp-static/2026/07/profimedia-1117498488.jpg?w=20\u0026h=20\u0026fit=crop\u0026fm=png"},{"width":30,"height":30,"url":"https://img.novydenik.com/wp-static/2026/07/profimedia-1117498488.jpg?w=30\u0026h=30\u0026fit=crop\u0026fm=png"},{"width":40,"height":40,"url":"https://img.novydenik.com/wp-static/2026/07/profimedia-1117498488.jpg?w=40\u0026h=40\u0026fit=crop\u0026fm=png"},{"width":60,"height":60,"url":"https://img.novydenik.com/wp-st