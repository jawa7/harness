ia-0788908194.jpg?w=20\u0026h=20\u0026fit=crop\u0026fm=png"},{"width":30,"height":30,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=30\u0026h=30\u0026fit=crop\u0026fm=png"},{"width":40,"height":40,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=40\u0026h=40\u0026fit=crop\u0026fm=png"},{"width":60,"height":60,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=60\u0026h=60\u0026fit=crop\u0026fm=png"},{"width":80,"height":80,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=80\u0026h=80\u0026fit=crop\u0026fm=png"},{"width":256,"height":256,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=256\u0026h=256\u0026fit=crop\u0026fm=png"}]},"excerpt":"","tags":[],"followable":true,"settings":[],"featured_text":"","parent_category":13,"url_spotify":null,"url_applepodcasts":null,"url_youtube":null,"url_more":null}],"image":null,"title":"Nejlépe placeným českým sportovcem je hokejista Pastrňák","embed":[],"seen":false,"forceNotSeen":false,"published_at_date":1786010784000,"isImportant":false,"isCollapsed":false,"shouldHideImageOnHome":false,"excerptOriginal":"\u003cp\u003e\u003cstrong\u003eNejlépe placeným českým sportovcem je hokejista David Pastrňák s ročním příjmem 275 milionů korun.\u003c/strong\u003e Dalšími jsou hokejista Tomáš Hertl a fotbalista Patrik Schick. Sportovkyní s nejvyšším příjmem je tenistka Karolína Muchová. (\u003ca data-link=\"ext\" target=\"_blank\" rel=\"noreferrer\" href=\"https://forbes.cz/lists/sportovci2026/nejlepe-placeni-sportovci-ceska-2026/?slide=1\"\u003eForbes\u003c/a\u003e) \u003c!--Poslední typografie: Kateřina Sikorová 6. 8. 2026 12:18:05--\u003e\u003c/p\u003e\n","hasReadMore":false},{"excerpt":"\u003cp\u003e\u003cstrong\u003eNa tenisovém turnaji v Torontu v noci skončily i další dvě české tenistky.\u003c/strong\u003e Krejčíková prohrála se Samsonovou 1:6 a 5:7 a Nosková vypadla s McNally 6:7 a 1:6. Jen po dvou kolech tak v soutěži z osmi Češek zůstala jen Bartůňková. V Montrealu Menšík vyřadil Fearnleyho 6:3, 3:6, 6:3. (\u003ca data-link=\"ext\" target=\"_blank\" rel=\"noreferrer\" href=\"https://www.espn.com/tennis/scoreboard/_/date/20260805\"\u003eESPN\u003c/a\u003e) \u003c!--Poslední typografie: Kateřina Sikorová 6. 8. 2026 7:40:32--\u003e\u003c/p\u003e\n","content":"","id":2147961,"url":"https://denikn.cz/minuta/2147961/","published_at":"2026-08-06T07:30:51+02:00","tags":[{"type":"tag","id":945,"slug":"tenis","url":"https://denikn.cz/tag/tenis/","name":"Tenis","image":{"id":945,"excerpt":"","sizes":[{"width":200,"height":134,"url":"https://denikn.cz/api/feature/tag/945/?w=200\u0026h=134"},{"width":720,"height":480,"url":"https://denikn.cz/api/feature/tag/945/?w=720\u0026h=480"},{"width":1600,"height":1067,"url":"https://denikn.cz/api/feature/tag/945/?w=1600\u0026h=1067"},{"width":2400,"height":1600,"url":"https://denikn.cz/api/feature/tag/945/?w=2400\u0026h=1600"}]},"icon":{"id":1192907,"excerpt":"Markéta Vondroušová. Foto: Kin Cheung, ČTK/AP","sizes":[{"width":15,"height":15,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=15\u0026h=15\u0026fit=crop\u0026fm=png"},{"width":20,"height":20,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=20\u0026h=20\u0026fit=crop\u0026fm=png"},{"width":30,"height":30,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=30\u0026h=30\u0026fit=crop\u0026fm=png"},{"width":40,"height":40,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=40\u0026h=40\u0026fit=crop\u0026fm=png"},{"width":60,"height":60,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=60\u0026h=60\u0026fit=crop\u0026fm=png"},{"width":80,"height":80,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=80\u0026h=80\u0026fit=crop\u0026fm=png"},{"width":256,"height":256,"url":"https://img.novydenik.com/wp-static/2023/07/profimedia-0788908194.jpg?w=256\u0026h=256\u0026fit=crop\u0026fm=png"}]},"excerpt":"","tags":[],"followable":true,"settings":[],"featured_text":"","parent_category":13,"url_spotify":null,"url_applepodcasts":null,"url_youtube":null,"url_more":null}],"image":null,"title":"","embed":[],"seen":false,"forceNotSeen":false,"published_at_date":1785994251000,"isImportant":false,"isCollapsed":false,"shouldHideImageOnHome":false,"excerptOriginal":"\u003cp\u003e\u003cstrong\u003eNa tenisovém turnaji v Torontu v noci skončily i další dvě české tenistky.\u003c/strong\u003e Krejčíková prohrála se Samsonovou 1:6 a 5:7 a Nosková vypadla s McNally 6:7 a 1:6. Jen po dvou kolech tak v soutěži z osmi Češek zůstala jen Bartůňková. V Montrealu Menšík vyřadil Fearnleyho 6:3, 3:6, 6:3. (\u003ca data-link=\"ext\" target=\"_blank\" rel=\"noreferrer\" href=\"https://www.espn.com/tennis/scoreboard/_/date/20260805\"\u003eESPN\u003c/a\u003e) \u003c!--Poslední typografie: Kateřina Sikorová 6. 8. 2026 7:40:32--\u003e\u003c/p\u003e\n","hasReadMore":false},{"excerpt":"\u003cp\u003e\u003cstrong\u003eDvě české tenistky na turnaji v Torontu skončily ve druhém kole.\u003c/strong\u003e Bouzková prohrála s Townsend těsně 6:7, 5:7 a Plíšková s Andrejevou naopak hladce 0:6, 2:6. Teď čekají zápasy Krejčíkovou a Noskovou. V Montrealu nastoupí Menšík. (\u003ca data-link=\"ext\" target=\"_blank\" rel=\"noreferrer\" href=\"https://www.espn.com/tennis/scoreboard\"\u003eESPN\u003c/a\u003e) \u003c!--Poslední typografie: Kateřina Sikorová 6. 8. 2026 7:12:01--\u003e\u003c/p\u003e\n","content":"","id":2147835,"url":"https://denikn.cz/minuta/2147835/","published_at":"2026-08-05T23:37:41+02:00","tags":[{"type":"tag","id":945,"slug":"tenis","url":"https://denikn.cz/tag/tenis/","name":"Tenis","image":{"id":945,"excerpt":"","sizes":[{"width":200,"height":134,"url":"https://denikn.cz/api/feature/tag/945/?w=200\u0026h=134"},{"width":720,"height":480,"url":"https://denikn.cz/api/feature/tag/945/?w=720\u0